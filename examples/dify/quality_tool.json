{
  "name": "quality_check",
  "description": "三层质检：重复率检测、事实性校验、格式规范检查",
  "parameters": {
    "type": "object",
    "properties": {
      "content_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "platform": {
        "type": "string",
        "default": "公众号"
      }
    },
    "required": ["content_id", "title", "body"]
  },
  "api": {
    "method": "POST",
    "url": "https://your-pipeline.com/api/v1/quality/check",
    "headers": {
      "Authorization": "Bearer {{api_key}}",
      "Content-Type": "application/json"
    }
  }
}

