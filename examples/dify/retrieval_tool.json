{
  "name": "knowledge_retrieval",
  "description": "从企业知识库检索相关内容",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "检索问题"
      },
      "top_k": {
        "type": "number",
        "default": 5
      },
      "threshold": {
        "type": "number",
        "default": 0.75
      }
    },
    "required": ["query"]
  },
  "api": {
    "method": "POST",
    "url": "https://your-pipeline.com/api/v1/kb/retrieval",
    "headers": {
      "Authorization": "Bearer {{api_key}}",
      "Content-Type": "application/json"
    }
  }
}

