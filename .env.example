# 用法：复制本文件为 .env 并填写真实密钥
# 注意：.env 已被 .gitignore 忽略，不会上传 GitHub；请勿把真实密钥写入 .env.example

# ---- 运行环境 ----
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO

# ---- 核心服务端口 ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- LLM（OpenAI 兼容协议，默认 DeepSeek）----
LLM_PROVIDER=deepseek            # mock | qwen | deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat     # 或 deepseek-reasoner

# ---- 阿里云百炼 Qwen（备用）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3

# ---- Embedding 模型（留空时使用确定性 hash Embedding，便于本地 demo）----
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=512
USE_DETERMINISTIC_EMBEDDINGS=false

# ---- 分块策略 ----
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ---- 检索 ----
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.75
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_KEYWORD=0.4

# ---- 存储 ----
DATABASE_URL=sqlite:///./data/pipeline.db
REDIS_URL=redis://localhost:6379/0

# ---- 分发 ----
PUBLISH_MODE=mock            # mock | real
PUBLISH_MAX_RETRIES=3

# ---- 质检 ----
SIMHASH_DUPLICATE_THRESHOLD=3
FACT_CHECK_REQUIRE_EVIDENCE=true
